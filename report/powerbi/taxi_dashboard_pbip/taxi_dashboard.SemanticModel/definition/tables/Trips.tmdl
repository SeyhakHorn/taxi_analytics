	measure 'Total Revenue' = SUM ( Trips[total] )
		formatString: $#,0
		displayFolder: Revenue
		lineageTag: a39258a4-fc77-bf41-daf2-edd5a09cc703

	measure 'Net Revenue' = SUM ( Trips[net_revenue] )
		formatString: $#,0
		displayFolder: Revenue
		lineageTag: 84f7a5b0-0498-b377-68b8-430e75071723

	measure 'Fare Revenue' = SUM ( Trips[fare] )
		formatString: $#,0
		displayFolder: Revenue
		lineageTag: 6803f290-ec5e-af48-6fa9-96f3e9c7255d

	measure Tips = SUM ( Trips[tip] )
		formatString: $#,0
		displayFolder: Revenue
		lineageTag: 33423589-3b9f-154b-c513-4bfc556d931a

	measure Tolls = SUM ( Trips[tolls] )
		formatString: $#,0
		displayFolder: Revenue
		lineageTag: 1b10fea7-4c7c-4ae6-8dc8-ddd2536ff665

	measure Surcharges = SUM ( Trips[surcharges] )
		formatString: $#,0
		displayFolder: Revenue
		lineageTag: a3f98b2c-c2b8-74b1-5c89-89587b6f5e2d

	measure 'Avg Revenue per Trip' = DIVIDE ( [Total Revenue], [Trips Count] )
		formatString: $#,0.00
		displayFolder: Revenue
		lineageTag: 02d0966b-41d0-92a4-8c12-e01665df861f

	measure 'Median Revenue per Trip' = MEDIAN ( Trips[total] )
		formatString: $#,0.00
		displayFolder: Revenue
		lineageTag: 4bc068e4-bd68-c5d0-b918-411cca6d5494

	measure 'Net Revenue per Trip' = DIVIDE ( [Net Revenue], [Trips Count] )
		formatString: $#,0.00
		displayFolder: Revenue
		lineageTag: 51ac31c9-7960-f81f-7f0a-04592e46d78d

	measure 'Revenue Share %' = DIVIDE ( [Total Revenue], CALCULATE ( [Total Revenue], ALLSELECTED ( Trips ) ) )
		formatString: 0.0%
		displayFolder: Shares
		lineageTag: 3f3900a8-4b00-9119-d0a7-f138dbf8c465

	measure 'Trip Share %' = DIVIDE ( [Trips Count], CALCULATE ( [Trips Count], ALLSELECTED ( Trips ) ) )
		formatString: 0.0%
		displayFolder: Shares
		lineageTag: 1ce0478f-98e3-ab7a-e5dc-ce1e0ab624aa

	measure 'Airport Revenue' = CALCULATE ( [Total Revenue], Trips[is_airport_trip] = "Airport" )
		formatString: $#,0
		displayFolder: Shares
		lineageTag: 0dfa04f4-23f8-5001-5294-dc5ea3037eac

	measure 'Airport Revenue Share %' = DIVIDE ( [Airport Revenue], [Total Revenue] )
		formatString: 0.0%
		displayFolder: Shares
		lineageTag: ac1fb554-34ee-a983-922e-2031cba55ed1

	measure 'Long Trip Revenue Share %' = DIVIDE ( CALCULATE ( [Total Revenue], Trips[distance_band] = "10+ mi" ), [Total Revenue] )
		formatString: 0.0%
		displayFolder: Shares
		lineageTag: cf7e921d-0449-b6f1-9cf6-381c44368379

	measure 'Manhattan Trip Share %' = DIVIDE ( CALCULATE ( [Trips Count], Trips[pickup_borough] = "Manhattan" ), [Trips Count] )
		formatString: 0.0%
		displayFolder: Shares
		lineageTag: cf863ffc-6715-82fa-2664-b546a3bf720c

	measure 'Avg Revenue per Airport Trip' = CALCULATE ( [Avg Revenue per Trip], Trips[is_airport_trip] = "Airport" )
		formatString: $#,0.00
		displayFolder: Shares
		lineageTag: abaf04dc-2e69-2aa9-643d-79a2b5d31ff7

	measure 'Avg Revenue per Non-Airport Trip' = CALCULATE ( [Avg Revenue per Trip], Trips[is_airport_trip] = "Non-airport" )
		formatString: $#,0.00
		displayFolder: Shares
		lineageTag: 7e7bfba7-1ab1-e914-4471-7bcbf4a7ffb1

	measure 'Days in Period' = COUNTROWS ( 'Date' )
		formatString: 0
