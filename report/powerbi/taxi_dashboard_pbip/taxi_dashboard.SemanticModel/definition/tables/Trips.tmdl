				    Source = Csv.Document(File.Contents(DataPath), [Delimiter=",", Columns=36, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"trip_id", Int64.Type}, {"pickup", type datetime}, {"dropoff", type datetime}, {"pickup_date", type date}, {"pickup_hour", Int64.Type}, {"pickup_day", type text}, {"day_order", Int64.Type}, {"day_type", type text}, {"time_period", type text}, {"time_period_order", Int64.Type}, {"color", type text}, {"payment", type text}, {"passengers", Int64.Type}, {"distance", type number}, {"distance_band", type text}, {"distance_band_order", Int64.Type}, {"duration_min", type number}, {"speed_mph", type number}, {"fare", type number}, {"surcharges", type number}, {"tip", type number}, {"tolls", type number}, {"total", type number}, {"net_revenue", type number}, {"tip_pct", type number}, {"revenue_per_mile", type number}, {"revenue_per_min", type number}, {"pickup_zone", type text}, {"dropoff_zone", type text}, {"pickup_borough", type text}, {"dropoff_borough", type text}, {"route", type text}, {"is_airport_trip", type text}, {"fare_outlier", type text}, {"is_flat_fare", type text}, {"data_quality_flag", type text}}, "en-US")
				in
