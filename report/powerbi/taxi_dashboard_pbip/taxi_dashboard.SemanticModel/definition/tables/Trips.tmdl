	/// Tip % grouped in 5-point bins; 50 means 50% or more.
	column 'Tip Bin (5%)' = IF ( ISBLANK ( Trips[tip_pct] ), BLANK (), INT ( MIN ( FLOOR ( Trips[tip_pct], 5 ), 50 ) ) )
		dataType: int64
		formatString: 0
		lineageTag: f4795c93-68eb-c6cc-7d8f-c15d388b6b9d
		summarizeBy: none

