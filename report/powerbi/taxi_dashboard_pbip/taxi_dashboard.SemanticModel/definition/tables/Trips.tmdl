		lineageTag: c1c3617f-0afb-b632-ceae-87b73c8237af

	measure 'Peak Hour' = VAR HourTable = ADDCOLUMNS ( VALUES ( Trips[pickup_hour] ), "@trips", [Trips Count] ) RETURN MAXX ( TOPN ( 1, HourTable, [@trips], DESC ), Trips[pickup_hour] )
		formatString: 0
		displayFolder: Demand
		lineageTag: 90494810-618b-40ae-47fe-f4579ca21eb1

	measure 'Peak Hour Label' = FORMAT ( [Peak Hour], "0" ) & ":00"
		displayFolder: Demand
		lineageTag: 01227827-ea93-b2f7-94bf-53905344cb32

	measure 'Card Trips' = CALCULATE ( [Trips Count], Trips[payment] = "credit card" )
		formatString: #,0
		displayFolder: Payments & Tips
		lineageTag: 675384e9-0ce2-f4d1-ca28-d4e260956562

	measure 'Card Share %' = DIVIDE ( [Card Trips], [Trips Count] )
		formatString: 0.0%
		displayFolder: Payments & Tips
		lineageTag: f0843959-ff34-8fac-8864-545a6b501e2a

	measure 'Cash Share %' = DIVIDE ( CALCULATE ( [Trips Count], Trips[payment] = "cash" ), [Trips Count] )
		formatString: 0.0%
		displayFolder: Payments & Tips
		lineageTag: 25983049-b4bc-7521-f884-f78736bd9fcb

	measure 'Avg Tip (Card)' = CALCULATE ( AVERAGE ( Trips[tip] ), Trips[payment] = "credit card" )
		formatString: $#,0.00
		displayFolder: Payments & Tips
		lineageTag: 59d2b107-3f85-6dec-5212-26d6a76767f2

	measure 'Median Tip % (Card)' = CALCULATE ( MEDIAN ( Trips[tip_pct] ), Trips[payment] = "credit card" )
		formatString: 0.0
		displayFolder: Payments & Tips
		lineageTag: e316d711-a26c-810f-4248-7804b589fb06

	measure 'No-Tip Rate (Card)' = DIVIDE ( CALCULATE ( [Trips Count], Trips[payment] = "credit card", Trips[tip] = 0 ), [Card Trips] )
		formatString: 0.0%
		displayFolder: Payments & Tips
		lineageTag: ff19f68b-f9f8-8af5-a2e4-81e04bc1d7b0

	measure 'Avg Duration (min)' = AVERAGE ( Trips[duration_min] )
		formatString: 0.0
		displayFolder: Efficiency
		lineageTag: 717ec641-b57b-75dd-f92c-76eabd442097

	measure 'Median Duration (min)' = MEDIAN ( Trips[duration_min] )
		formatString: 0.0
		displayFolder: Efficiency
		lineageTag: e2880043-ee63-7240-2f13-d49e65d8813a

	measure 'Avg Distance (mi)' = AVERAGE ( Trips[distance] )
		formatString: 0.00
		displayFolder: Efficiency
		lineageTag: 9d0db8de-ff6d-bf09-51f2-7141a381ae49

	measure 'Avg Speed (mph)' = DIVIDE ( SUM ( Trips[distance] ), SUM ( Trips[duration_min] ) / 60 )
		formatString: 0.0
		displayFolder: Efficiency
		lineageTag: 27a5eb6e-019c-dcdb-c8bd-db90ffe776f1

	measure 'Revenue per Mile' = DIVIDE ( [Total Revenue], SUM ( Trips[distance] ) )
		formatString: $#,0.00
		displayFolder: Efficiency
		lineageTag: 61b6d773-4ea4-96be-4828-ee4120043ef4

	measure 'Revenue per Minute' = DIVIDE ( [Total Revenue], SUM ( Trips[duration_min] ) )
		formatString: $#,0.00
		displayFolder: Efficiency
		lineageTag: b0565df0-756f-0341-b4bc-7b41fffad1bb

	measure 'Revenue per Hour Driven' = [Revenue per Minute] * 60
		formatString: $#,0.00
		displayFolder: Efficiency
		lineageTag: 128a7d34-f62f-2007-206d-1c1a4fbfe7a5

	measure 'Long Trips (> 36.5 min)' = CALCULATE ( [Trips Count], Trips[duration_min] > 36.5 )
		formatString: #,0
		displayFolder: Efficiency
		lineageTag: e7dadb7d-118f-9a0d-bc6e-637db0f8f9b3

	measure 'Traffic-Stuck Trips' = CALCULATE ( [Trips Count], Trips[duration_min] > 30, Trips[distance] < 3 )
		formatString: #,0
		displayFolder: Efficiency
		lineageTag: 24fa5384-f137-a02f-9244-7ab894ceffd2

	measure 'Suspicious Fares' = CALCULATE ( [Trips Count], Trips[data_quality_flag] = "Suspicious fare" )
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 06bd203f-3eb7-4192-5127-caa1b7934b46

	measure 'Fare Outliers' = CALCULATE ( [Trips Count], Trips[fare_outlier] = "Yes" )
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: f686be49-1941-8e53-c935-353b81fe71fb

	measure 'Unknown Zone Trips' = CALCULATE ( [Trips Count], Trips[pickup_zone] = "Unknown" )
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: bceaf916-a121-a541-238e-e79eeac1268f

	measure 'Title Overview' = "Net revenue " & FORMAT ( [Net Revenue], "$#,0" ) & " from " & FORMAT ( [Trips Count], "#,0" ) & " trips"
		displayFolder: Titles
		lineageTag: 1554e485-3c02-85ce-762b-2e4f45c67227

	measure 'Title Demand' = "Demand peaks at " & [Peak Hour Label] & " · " & FORMAT ( [Trips per Day], "0" ) & " trips per day"
		displayFolder: Titles
		lineageTag: ba877453-0036-29cd-3118-80b440249a27

